{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "The notch: media, focus, CodeNotch, clipboard, prompter.",
  "windows": [
    "island"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ambient-wallpaper",
    "allow-clipboard-clear",
    "allow-clipboard-copy",
    "allow-clipboard-list",
    "allow-clipboard-remove",
    "allow-code-connect",
    "allow-code-connect-provider",
    "allow-code-detect",
    "allow-code-dismiss",
    "allow-code-hook-status",
    "allow-code-open-folder",
    "allow-code-providers",
    "allow-code-refresh-usage",
    "allow-code-sessions",
    "allow-code-usage",
    "allow-island-flags",
    "allow-island-set-extent",
    "allow-media-cycle-session",
    "allow-media-get",
    "allow-media-next",
    "allow-media-play-pause",
    "allow-media-previous",
    "allow-media-seek",
    "allow-open-settings-window",
    "allow-pomo-get",
    "allow-pomo-pause",
    "allow-pomo-reset",
    "allow-pomo-set-length",
    "allow-pomo-skip",
    "allow-pomo-start",
    "allow-prompter-set-active",
    "allow-prompter-start",
    "allow-quick-action-run",
    "allow-script-create",
    "allow-script-save",
    "allow-scripts-list",
    "allow-set-hit-rect",
    "allow-settings-get",
    "allow-settings-set",
    "allow-system-get",
    "allow-system-set-stats-active",
    "allow-voice-start",
    "allow-voice-stop"
  ]
}
